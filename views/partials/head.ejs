<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#f7f6f1">
  <meta name="visag-whatsapp-number" content="<%= whatsappNumber %>">
  <meta name="description" content="VisagShop - ropa urbana al detal y por mayor desde Lebrija, Santander.">
  <title><%= pageTitle || 'VisagShop' %></title>
  <link rel="icon" type="image/png" href="/img/logo-visagshop-128.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/modern.css">
  <link rel="stylesheet" href="/css/atelier.css">
  <% if (isCheckout) { %><link rel="stylesheet" href="/css/checkout.css"><% } %>
  <% if (isAdmin) { %><link rel="stylesheet" href="/css/admin.css"><% } %>
  <link rel="stylesheet" href="/css/sprint4.css">
  <link rel="stylesheet" href="/css/sprint5.css">
  <script src="/js/site.js" defer></script>
  <% if (pageScript) { %><script src="/js/<%= pageScript %>" defer></script><% } %>
</head>
<body<% if (isCheckout) { %> class="checkout-page"<% } %>>
<a class="skip-link" href="#contenido">Saltar al contenido</a>

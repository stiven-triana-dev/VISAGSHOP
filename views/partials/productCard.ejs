<article class="product-card">
  <div class="product-media">
    <a href="/products/<%= encodeURIComponent(p.id) %>" aria-label="Ver <%= p.nombre %>"><img src="<%= p.imagen %>" alt="<%= p.nombre %>" loading="<%= index<4?'eager':'lazy' %>" width="360" height="450"></a>
    <span class="product-tag"><%= Number.isFinite(p.precio)?'DISPONIBLE EN CATÁLOGO':'PRECIO POR CONFIRMAR' %></span>
    <button type="button" class="heart-btn" data-favorite="<%= p.id %>" aria-pressed="false" aria-label="Guardar en favoritos: <%= p.nombre %>">♡</button>
  </div>
  <div class="product-caption"><span class="product-meta"><%= p.categoria %></span><h3 class="product-title"><a href="/products/<%= encodeURIComponent(p.id) %>"><%= p.nombre %></a></h3>
    <div class="product-bottom"><span class="product-price <%= Number.isFinite(p.precio)?'':'no-price' %>"><%= Number.isFinite(p.precio)?money(p.precio):'Precio por consultar' %></span><a class="product-arrow" href="/products/<%= encodeURIComponent(p.id) %>">VER PRENDA <span aria-hidden="true">↗</span></a></div>
    <p class="product-sizes"><%= p.tallas && p.tallas.length ? 'Tallas: '+p.tallas.join(' · ') : 'Consultar tallas' %></p>
  </div>
</article>

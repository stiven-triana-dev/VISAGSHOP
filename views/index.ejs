<%- include("partials/head") %>
<%- include("partials/header") %>
<main id="contenido">
  <section class="atelier-hero" aria-labelledby="hero-titulo">
    <div class="shell atelier-hero-grid">
      <div class="atelier-copy">
        <div class="atelier-eyebrow"><img class="atelier-logo-chip" src="/img/logo-visagshop.png" alt="" width="28" height="28"><span>VISAGSHOP / COLECCIÓN URBANA</span> <span class="atelier-season">2026 — COLOMBIA</span></div>
        <div class="atelier-copy-main">
          <span class="atelier-counter">NUEVA MIRADA. MISMA ESENCIA.</span>
          <h1 id="hero-titulo">VÍSTELO<br>A TU <em>manera.</em></h1>
          <p>Prendas esenciales, actitud propia. Explora nuestra selección de jeans, gorras, tenis y más, sin complicaciones.</p>
          <div class="atelier-actions"><a class="btn btn-black" href="#catalogo">EXPLORAR PRODUCTOS <span aria-hidden="true">↗</span></a><a class="atelier-minor-link" href="#categorias">Ver categorías <span aria-hidden="true">→</span></a></div>
        </div>
        <div class="atelier-caption"><span>01 / VISAGSHOP</span><span>LEBRIJA · SANTANDER</span><a href="#categorias" aria-label="Desplazarse a categorías">DESLIZAR ↓</a></div>
      </div>
      <div class="atelier-visual">
        <div class="atelier-portrait"><img src="/img/p049.jpg" alt="Jean de corte amplio azul de VisagShop" fetchpriority="high" width="680" height="800"><span>DENIM / EDICIÓN URBANA</span></div>
        <div class="atelier-inset"><img src="/img/p029.jpg" alt="Gorra negra de la colección VisagShop" width="320" height="380"><span>LOS DETALLES IMPORTAN.</span></div>
        <div class="atelier-visual-index">VISAG / 001</div>
      </div>
    </div>
  </section>
  <div class="atelier-ticker"><div class="shell"><span>ESTILO URBANO</span><i></i><span>AL DETAL Y POR MAYOR</span><i></i><span>COMPRA POR WHATSAPP</span><i></i><span>LEBRIJA · COLOMBIA</span></div></div>
  <section class="quick-benefits shell" aria-label="Servicios de la tienda"><div><span class="quick-symbol">↗</span><span><strong>ENVÍOS A COLOMBIA</strong><small>Cobertura y tarifas por confirmar</small></span></div><div><span class="quick-symbol">✳</span><span><strong>AL DETAL Y POR MAYOR</strong><small>Compra como tú prefieras</small></span></div><div><span class="quick-symbol">◎</span><span><strong>ATENCIÓN PERSONALIZADA</strong><small>Estamos en WhatsApp</small></span></div></section>
  <section class="category-edit shell section-modern" id="categorias">
    <div class="modern-heading"><div><div class="section-eyebrow"><span class="section-number">01</span><span>ENCUENTRA TU ESTILO</span></div><h2>ENCUENTRA TU <em>estilo.</em></h2></div><a class="link-arrow" href="#catalogo">VER TODOS LOS PRODUCTOS <span>↗</span></a></div>
    <div class="category-gallery">
      <a class="category-tile tile-jeans" href="#catalogo" data-go-category="Pantalones"><img src="/img/p043.jpg" alt="Jean baggy con costuras"><span class="tile-top">01 / JEANS</span><div class="tile-bottom"><span>JEANS<br><small>Un fit diferente cada día</small></span><b>↗</b></div></a>
      <a class="category-tile tile-shorts" href="#catalogo" data-go-category="Pantalonetas"><img src="/img/p081.jpg" alt="Pantaloneta de jean azul"><span class="tile-top">02 / SHORTS</span><div class="tile-bottom"><span>SHORTS<br><small>Comodidad con actitud</small></span><b>↗</b></div></a>
      <a class="category-tile tile-hats" href="#catalogo" data-go-category="Gorras"><img src="/img/p025.jpg" alt="Gorra azul con visera"><span class="tile-top">03 / ACCESORIOS</span><div class="tile-bottom"><span>GORRAS<br><small>El toque final</small></span><b>↗</b></div></a>
      <a class="category-tile tile-shoes" href="#catalogo" data-go-category="Zapatos"><img src="/img/p098.jpg" alt="Tenis blancos y negros"><span class="tile-top">04 / FOOTWEAR</span><div class="tile-bottom"><span>TENIS<br><small>Tu camino, tu look</small></span><b>↗</b></div></a>
    </div>
  </section>
  <section class="lookbook-statement shell" aria-label="Manifiesto VisagShop"><div class="statement-image"><img src="/img/p103.jpg" alt="Tenis urbanos negros de VisagShop" loading="lazy"><span>VISAG / INSPIRED BY THE STREETS</span></div><div class="statement-copy"><div class="section-eyebrow"><span class="section-number">VISAG / 26</span><span>UNA FORMA DE EXPRESARTE</span></div><h2>MENOS RUIDO.<br><em>Más estilo.</em></h2><p>Una buena prenda no necesita decir demasiado. Encuentra tus básicos favoritos y construye un look que se sienta tuyo.</p><a class="btn btn-lime" href="#catalogo">DESCUBRE TU PRÓXIMO FIT <span>↗</span></a><div class="statement-stamp">YOUR STYLE. / VISAG. <span>✳</span></div></div></section>
  <section class="catalog-modern section-modern" id="catalogo"><div class="shell">
    <div class="modern-heading catalog-heading"><div><div class="section-eyebrow"><span class="section-number">02</span><span>TODO LO QUE VA CONTIGO</span></div><h2>LA <em>colección.</em></h2><p class="catalog-intro">Piezas para combinar a tu manera. Busca por estilo, talla o categoría.</p></div><div class="catalog-index"><%= products.length %> <small>REFERENCIAS</small></div></div>
    <div class="catalog-tools"><label class="search-box"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg><span class="sr-only">Buscar productos</span><input id="buscar" type="search" placeholder="Buscar jeans, tenis, gorras..." autocomplete="off"></label><div class="right-tools"><label class="sort-wrap"><span>Ordenar por</span><select id="ordenar" aria-label="Ordenar productos"><option value="destacados">Destacados</option><option value="nombre">Nombre A–Z</option><option value="menor">Precio: menor a mayor</option><option value="mayor">Precio: mayor a menor</option></select></label><button class="favorites-filter" id="solo-favoritos" type="button" aria-pressed="false"><span aria-hidden="true">♡</span> Favoritos</button></div></div>
    <div class="filtros" role="group" aria-label="Filtrar productos por categoría"><button type="button" class="activo" data-cat="Todos" aria-pressed="true">Ver todo</button><button type="button" data-cat="Pantalones">Jeans</button><button type="button" data-cat="Pantalonetas">Pantalonetas</button><button type="button" data-cat="Bermudas">Bermudas</button><button type="button" data-cat="Sudaderas">Sudaderas</button><button type="button" data-cat="Gorras">Gorras</button><button type="button" data-cat="Zapatos">Tenis</button></div>
    <div class="catalog-result"><span id="resultados" role="status" aria-live="polite">Cargando productos...</span><label class="check-line"><input id="solo-precio" type="checkbox"> Solo con precio visible</label></div>
    <div class="productos" id="productos" aria-live="polite"><% products.slice(0,12).forEach(function(product, index) { %><%- include('partials/productCard', {p:product,index:index}) %><% }) %></div>
    <div class="empty-state" id="sin-resultados" hidden><span>⌕</span><h3>NO ENCONTRAMOS ESE FIT.</h3><p>Prueba con otra búsqueda o cambia los filtros.</p><button class="btn btn-black" id="limpiar" type="button">LIMPIAR FILTROS ↗</button></div>
    <div class="load-more"><button class="btn btn-outline-dark" type="button" id="mas" hidden>DESCUBRIR MÁS PRODUCTOS <span>↓</span></button></div>
  </div></section>
  <section class="wholesale-modern" id="mayoristas"><div class="shell wholesale-modern-layout"><div class="wholesale-left"><div class="section-eyebrow"><span class="section-number">03</span><span>VISAG PARA NEGOCIOS</span></div><h2>CRECEMOS<br><em>contigo.</em></h2><p>¿Compras por mayor o estás comenzando a vender? Hablemos de referencias, cantidades y precios para tu negocio.</p><a class="btn btn-black" href="https://wa.me/message/MWVYODQ6ZZILP1" target="_blank" rel="noopener noreferrer">COTIZAR POR WHATSAPP <span>↗</span></a><span class="wholesale-small">VENTAS AL DETAL &amp; POR MAYOR / LEBRIJA</span></div><div class="wholesale-new-photo"><img src="/img/p050.jpg" alt="Jean urbano gris de VisagShop" loading="lazy"><div class="wholesale-circle">CRECE<br>CON<br><strong>VISAG ↗</strong></div></div></div></section>
  <section class="buying-steps shell" id="como-comprar" aria-labelledby="como-comprar-titulo">
    <div class="buying-heading"><span class="section-eyebrow">COMPRA FÁCIL Y PERSONALIZADA</span><h2 id="como-comprar-titulo">Así de <em>sencillo.</em></h2><p>Eliges lo que te gusta y coordinamos los detalles contigo.</p></div>
    <div class="steps-list"><div><span>01</span><h3>Elige tus prendas</h3><p>Explora el catálogo, revisa las referencias y selecciona tu talla.</p></div><div><span>02</span><h3>Prepara tu carrito</h3><p>Añade tus favoritos y ajusta las cantidades antes de continuar.</p></div><div><span>03</span><h3>Habla con la tienda</h3><p>Envía tu pedido por WhatsApp para confirmar disponibilidad, envío y valor final.</p></div></div>
  </section>
  <section class="closing-modern shell"><div><span class="section-eyebrow">04 / CONECTEMOS</span><h2>LO QUE SIGUE<br>ESTÁ EN <em>Instagram.</em></h2></div><div><p>Nuevos estilos, combinaciones y novedades de VisagShop. Conecta con nosotros.</p><a class="btn btn-black" href="https://www.instagram.com/visagshop" target="_blank" rel="noopener noreferrer">VISÍTANOS EN INSTAGRAM <span>↗</span></a></div></section>
</main>
<%- include("partials/footer") %>
